#!/usr/bin/env bash
# Source-tree convenience wrapper. Installed packages expose the same `pet` command.
set -u

SCRIPT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${PET_ROOT:-}" ]]; then
    ROOT="$PET_ROOT"
elif [[ -f "$SCRIPT_ROOT/Cargo.toml" && -d "$SCRIPT_ROOT/desktop-pet" ]]; then
    ROOT="$SCRIPT_ROOT"
else
    ROOT="$HOME/.local/opt/linux-desktop-pet"
fi

target_root="${CARGO_TARGET_DIR:-$ROOT/target}"
if [[ "$target_root" != /* ]]; then
    target_root="$ROOT/$target_root"
fi
binary="$target_root/release/pet"

if [[ "${1:-}" == "build" || "${2:-}" == "build" ]]; then
    exec cargo build --release --manifest-path "$ROOT/Cargo.toml" -p desktop-pet
fi

if [[ ! -x "$binary" ]]; then
    echo "找不到统一程序：$binary" >&2
    echo "先运行：pet build" >&2
    exit 1
fi

exec "$binary" "$@"
